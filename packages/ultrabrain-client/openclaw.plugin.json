{
  "id": "ultrabrain-personal",
  "name": "Ultrabrain Personal",
  "description": "Additive read-only personal recall; exact workspace, agent and session required",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "profilePath",
      "agentIds",
      "sessionKeys"
    ],
    "properties": {
      "profilePath": {
        "type": "string",
        "minLength": 1
      },
      "agentIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "sessionKeys": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
