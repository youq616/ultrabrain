{
  "name": "ultrabrain",
  "version": "0.5.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Linux-native PostgreSQL agent memory with GBrain compatibility and hierarchical context",
  "license": "MIT",
  "bin": {
    "ultrabrain": "src/cli.mjs"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "bun test/integration.mjs",
    "upstream:check": "python3 scripts/upstreams.py check",
    "upstream:verify": "python3 scripts/upstreams.py verify",
    "test:ops": "python3 -m unittest discover -s test -p 'test_*.py'",
    "test:http": "bun test/http-integration.mjs",
    "test:reliability": "bun test/reliability-integration.mjs",
    "eval:memory": "bun test/memory-eval.mjs",
    "compat": "bun src/cli.mjs compat",
    "test:upgrade": "bash scripts/test-upgrade.sh",
    "test:evidence": "bun test/revision-evidence-integration.mjs",
    "test:deferred": "bun test/deferred-integration.mjs",
    "test:semantic": "bun test/semantic-integration.mjs"
  }
}
